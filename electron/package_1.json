{
  "name": "cloudguard-ai",
  "version": "1.0.0",
  "description": "CloudGuard AI - AI-Native Desktop Security Platform",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "build": {
    "appId": "com.cloudguard.ai",
    "productName": "CloudGuard AI",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-os-utils": "^1.3.7",
    "systeminformation": "^5.21.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
